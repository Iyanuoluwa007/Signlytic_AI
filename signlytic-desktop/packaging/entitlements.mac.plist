<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied to the app and to everything signed inside it, including the caption
  helper, which is the process that actually opens the microphone.

  Not in build/, which is where electron-builder would put it by convention,
  because the repository ignores build/ everywhere for Python artefacts and
  this is source that has to be committed.

  audio-input is the one that matters. The JIT and unsigned-memory entitlements
  are what Electron itself needs under the hardened runtime; without them the
  renderer cannot run and the app dies at launch rather than at caption time.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
