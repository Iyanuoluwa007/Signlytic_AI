# Signlytic AI server environment.
#
# Copy to /etc/signlytic/signlytic.env on the host, fill it in, then:
#   sudo chown root:root /etc/signlytic/signlytic.env
#   sudo chmod 600 /etc/signlytic/signlytic.env
# It holds API keys, so it must not be world readable and must never be
# committed.

# ── Required when the server is reachable from anywhere but localhost ────────
# Without this, app_server refuses to bind to a non-loopback address, because
# /api/shutdown would otherwise be an unauthenticated kill switch.
# Generate one with:  openssl rand -hex 32
SIGNLYTIC_ADMIN_TOKEN=

# ── Demo box settings ────────────────────────────────────────────────────────
# 1 turns off video recognition, speech transcription and voice synthesis, and
# returns a message pointing at the full download instead. Those need a GPU, so
# on a CPU-only free tier they would take tens of seconds and queue. The text
# and signing paths stay fully live.
SIGNLYTIC_DEMO_MODE=1

# Where the "get the full app" message sends people.
SIGNLYTIC_FULL_APP_URL=https://github.com/Iyanuoluwa007/Signlytic_AI/releases/latest

# Requests per minute per client for the compute-heavy endpoints. 0 disables.
SIGNLYTIC_RATE_LIMIT=20

# ── Where sign frames come from ──────────────────────────────────────────────
# Locally the server reads data/poses, which is 2.6 GB, plus another 1.4 GB of
# sign JSON. None of that is in the repository, so a hosted box has neither.
# Setting this points sign lookups at the website endpoint, which already serves
# exactly this data and caches it, so the box carries no data at all.
# Leave it blank on your own machine to use the local pose data.
SIGNLYTIC_SIGNS_API=https://signlytic-ai-website.vercel.app/api/signs

# Only needed if this server should serve /api/signs itself. It refuses
# non-localhost callers by default, which is right for a machine serving its own
# extension and wrong behind a proxy. Leave unset when SIGNLYTIC_SIGNS_API is in
# use, because then this box is a client of that endpoint, not a source for it.
# SIGNLYTIC_SIGNS_PUBLIC=1

# ── Language model providers ─────────────────────────────────────────────────
# Cerebras is primary, Groq is the fallback. Either alone is enough to start.
# Cerebras allows only 5 requests per minute on the free tier, so on a shared
# demo box most traffic will be served by Groq. Set both.
CEREBRAS_API_KEY=
GROQ_API_KEY=

# How many signs to keep in memory. Each is a few hundred KB once parsed, so
# the default 512 can reach a few hundred MB. Lower it to about 64 on a 1 GB
# shape such as VM.Standard.E2.1.Micro; the cost is more refetches, not
# correctness.
# SIGNLYTIC_SIGN_CACHE=64
